#!/bin/bash
set -eufo pipefail

{{ $brews := list
  "wget" 
  "curl" 
  "xz" 
  "mise" -}}



{{ $casks := list
  "ghostty"
  "codex" -}}

brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
